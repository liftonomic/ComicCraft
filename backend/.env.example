# Copy this file to `backend/.env` and fill in your real values.
#   copy backend\.env.example backend\.env
#
# `backend/.env` is listed in .gitignore, so your keys are never committed.
# Every value below is optional — leave a key empty (or delete the line) and
# ComicCraft falls back to its built-in default, which is the offline mode.
#
# Pydantic-settings reads this file (see backend/app/config.py) and the real
# process environment always wins over it.

# =============================================================================
# Application
# =============================================================================

APP_NAME=ComicCraft
APP_VERSION=0.1.0

# development | staging | production
APP_ENV=development

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins. Use * for development.
# Only needed when the frontend is served from a different origin than the API.
CORS_ORIGINS=["*"]

# =============================================================================
# AI / story generation  (Google Gemini)
# =============================================================================
# Leave GEMINI_API_KEY empty to run 100% offline: the backend automatically
# swaps in MockGeminiClient, which returns deterministic canned story data.
# With a real key set, the pipeline calls the live Gemini API instead.
#
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used for character profiles, comic outlines, panel copy and
# regeneration/continuation prompts.
GEMINI_MODEL=gemini-2.0-flash

# =============================================================================
# Image generation
# =============================================================================
# `mock`  = offline, deterministic PNGs (no external service). Safe default.
# `stable_diffusion` = real images from a local/remote AUTOMATIC1111 WebUI.
# Unknown values raise a ValueError at startup.
IMAGE_PROVIDER=mock

# AUTOMATIC1111 (or compatible) WebUI endpoint. Used only when
# IMAGE_PROVIDER=stable_diffusion.
SD_API_URL=http://127.0.0.1:7860

# Optional basic auth for the WebUI as `user:password`. Empty if none.
SD_API_AUTH=

# txt2img tuning. Raise STEPS for quality / lower for speed.
SD_WIDTH=768
SD_HEIGHT=512
SD_STEPS=28
SD_CFG_SCALE=7.0
SD_SAMPLER_NAME=DPM++ 2M Karras

# =============================================================================
# Comic generation limits
# =============================================================================
# Enforced by POST /api/comics (panel_count is validated against these).
MIN_PANEL_COUNT=1
MAX_PANEL_COUNT=20

# =============================================================================
# Storage
# =============================================================================
# Generated panel images and exported PDFs. Relative paths resolve against
# the backend/ directory. Served by the API at /generated.
# Absolute path to where generated images + PDFs are written.
# MUST be absolute — a relative path crashes startup, because StaticFiles
# resolves it against the process working directory rather than backend/.
STORAGE_BASE=C:/Users/DannBerlinD/Python/Learn/ComicCraft/backend/generated
IMAGES_DIR_NAME=images
PDFS_DIR_NAME=pdfs
